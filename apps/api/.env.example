# --- API ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance?schema=public
# Public HTTPS origin the students open from the QR code (no trailing slash)
PUBLIC_WEB_URL=https://localhost:8443
# Comma-separated list of allowed browser origins (CORS + socket.io)
CORS_ORIGINS=http://localhost:3000,https://localhost:8443
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS (production). Cookies get the Secure flag.
COOKIE_SECURE=false
# Optional. When set, BullMQ (email queue) and the rate limiter use Redis.
REDIS_URL=
# Optional SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# When empty, e-mails are written to apps/api/.outbox (development only).
SMTP_URL=
MAIL_FROM="Attendance Platform <no-reply@example.edu>"
# Trust X-Forwarded-For from the reverse proxy
TRUST_PROXY=true
