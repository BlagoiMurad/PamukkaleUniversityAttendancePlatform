# Used by docker-compose.yml. Copy to .env and fill in.
JWT_ACCESS_SECRET=   # openssl rand -base64 48
POSTGRES_PASSWORD=attendance
PUBLIC_WEB_URL=https://localhost:8443
# Production: your domain, e.g. attendance.pau.edu.tr (Caddy gets a certificate automatically)
SITE_ADDRESS=:8443
# Leave empty to use the bundled Mailpit (http://localhost:8025)
SMTP_URL=
